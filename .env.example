# Required: either a direct Anthropic Console API key...
# Read only inside the server function handler (src/lib/research.functions.ts),
# never bundled to the client. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ...or, if you're going through an internal Anthropic-compatible gateway
# instead, set these two (leave ANTHROPIC_API_KEY blank):
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Anthropic model ID. If ANTHROPIC_BASE_URL is set, this is passed through to
# the gateway verbatim (including any routing prefix it expects, e.g.
# "vertex_ai/claude-opus-4-8") — do not strip it.
ANTHROPIC_MODEL=claude-opus-4-8

# From https://firecrawl.dev dashboard — used for real web retrieval,
# replacing the DuckDuckGo scrape fallback once wired into research.server.ts.
# Read only inside the server function handler, never bundled to the client.
# Note: credits are metered, so live brand lookups do NOT use this by default
# — only scripts/refresh-brand-cache.mjs (the daily cache batch) does, via
# researchBrand(brand, { allowFirecrawl: true }). See research.server.ts.
FIRECRAWL_API_KEY=

# Set to "false" once your org's Vertex AI policy allows the
# web_search/web_fetch partner-model features again — until then, this
# defaults to skipping those two tiers (they were confirmed 100% blocked) and
# going straight to the DuckDuckGo fallback, saving ~40s of dead-end retries
# per topic on every live lookup that doesn't use Firecrawl.
CLAUDE_WEB_TOOLS_BLOCKED=true

# --- Brand cache storage (MongoDB) -----------------------------------------
# Leave MONGODB_URI empty to use the local flat-file cache (data/brand-cache/).
# Set it to use MongoDB (required on Vercel — its filesystem is read-only).
# The MongoDB Atlas Vercel integration sets MONGODB_URI automatically; get it
# locally with `npx vercel env pull .env.local`.
MONGODB_URI=
# Database name (collections: brand_cache, refresh_state).
MONGODB_DB=reliability-check

# --- Scheduled refresh (Vercel Cron) ----------------------------------------
# Random string (e.g. `openssl rand -hex 32`). Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>" on every cron call; other callers get 401.
CRON_SECRET=
# The cache is refreshed in one full sweep every 90 days. During a sweep, each
# cron run refreshes this many brands (each takes up to ~120s; run in parallel).
REFRESH_BATCH_SIZE=2
# Firecrawl is used only while the account has credits (checked before each
# brand); otherwise DuckDuckGo. Set to "false" to never use Firecrawl.
REFRESH_USE_FIRECRAWL=true
